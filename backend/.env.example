# ============================================================
#  CodeWeave — environment template
#  Copy to `.env` and fill in. NEVER commit the real .env.
# ============================================================

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Public URLs (production: your Render URLs)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ---------------- MongoDB Atlas ----------------
# mongodb+srv://<user>:<pass>@<cluster>/codeweave?retryWrites=true&w=majority
MONGODB_URI=

# ---------------- GitHub App ----------------
# GitHub → Settings → Developer settings → GitHub Apps → your app
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Dev: path to the downloaded .pem. Render: paste the PEM into GITHUB_PRIVATE_KEY
# (newlines as literal \n) and leave the path empty.
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
# Webhooks — must match the secret configured in the GitHub App
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=http://localhost:5000/api/github/webhook
# Local webhook relay channel (npm run webhook:proxy -- --new prints one).
SMEE_URL=

# ---------------- Groq (LLM) ----------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_MS=90000
# Tokens-per-minute ceiling of your Groq plan (free on-demand tier = 8000).
# Raise this after upgrading and every prompt gets more context automatically.
GROQ_TPM_LIMIT=8000

# ---------------- Qdrant Cloud ----------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=codeweave_chunks

# ---------------- Embeddings (all-MiniLM-L6-v2, 384 dims) ----------------
# local = @huggingface/transformers ONNX inference inside this Node process
# hf    = Hugging Face hosted inference API (requires HF_TOKEN)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=16
HF_TOKEN=

# ---------------- Sessions & crypto ----------------
# openssl rand -hex 48
SESSION_SECRET=
# openssl rand -hex 32  (exactly 32 bytes / 64 hex chars — AES-256-GCM)
ENCRYPTION_KEY=

# ---------------- Indexing limits ----------------
MAX_FILES=500
MAX_FILE_SIZE=180000
MAX_CHUNK_CHARS=1800
MAX_TOTAL_CHUNKS=6000
INDEX_CONCURRENCY=6
WORKER_ENABLED=true
WORKER_POLL_MS=2500
