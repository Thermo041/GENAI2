{
  "name": "codeweave-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CodeWeave backend — AI-powered GitHub codebase intelligence (Node + Express, JavaScript only)",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/jobs/worker.standalone.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:services": "node scripts/checkServices.js",
    "warm:embeddings": "node scripts/warmEmbeddings.js",
    "webhook:proxy": "node scripts/webhookProxy.js",
    "webhook:test": "node scripts/webhookSmoke.js",
    "seed:demo": "node scripts/seedDemoRepo.js",
    "verify:write": "node scripts/verifyWriteFlow.js",
    "review:pr": "node scripts/reviewPr.js"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@babel/traverse": "7.29.8",
    "@babel/types": "7.29.8",
    "@huggingface/transformers": "4.2.0",
    "@langchain/core": "1.2.9",
    "@langchain/groq": "1.3.1",
    "@octokit/auth-app": "8.3.0",
    "@octokit/auth-oauth-user": "6.0.3",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/rest": "22.0.1",
    "@octokit/webhooks-methods": "6.0.0",
    "@qdrant/js-client-rest": "1.19.0",
    "connect-mongo": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "diff": "9.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "mongoose": "9.9.4",
    "nanoid": "6.0.1",
    "p-limit": "7.3.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3",
    "smee-client": "5.0.0",
    "supertest": "7.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.4"
  }
}
